{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Deploy & Launch [SIM]",
      "type": "shell",
      "command": "python",
      "osx": {
        "command": "${command:python.interpreterPath}"
      },
      "windows": {
        "command": "${command:python.interpreterPath}"
      },
      "args": [
        "${workspaceFolder}/.vscode/scripts/deploy.py",
        "--lang",
        "${config:planesim.deploy.language}",
        "--step",
        "sensors"
      ],
      "options": {
        "env": {
          "RFSUITE_LANG": "${config:planesim.deploy.language}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "PlaneSim: Set Deployment Language",
      "type": "shell",
      "command": "node",
      "args": [
        ".vscode/set-language.js",
        "${input:deployLanguage}"
      ],
      "problemMatcher": []
    },
